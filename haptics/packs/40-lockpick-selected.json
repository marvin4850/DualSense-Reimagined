      },
      "note": "Every real L2/R2 plate move: Weapon resistance 4->5 -> dry release -> vibration tail on the same trigger."
    },
    {
      "id": "lp-trigger-up",
      "event": "lp:update",
      "where": {
        "ph": "trigup"
      },
      "priority": "normal",
      "pad": {
        "release": "=side",
        "note": "v29: the finger let go below 0.20: a trigger parked after its tail gets its profile (click / offpath) back"
      },
      "note": "Re-arm of the trigger click after the release; nothing else."
