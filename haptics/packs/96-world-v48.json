  {
   "id": "ride-land",
   "event": "rideair:complete",
   "let": {
    "eff": "round(has(net) ? net + 0.3 * max(0, drop - net) : drop)",
    "u": "clamp((eff - 20) / 600, 0, 1)"
   },
   "when": "=eff >= 25",
   "effect": {
    "layers": [
     {
      "preset": "Sample",
      "bank": "landing",
      "name": "land_light",
      "slot": "landing.land_light",
      "variant": "A",
      "intensity": "=min(1, 1.2 * (0.12 + 0.30 * clamp((eff - 20) / 130, 0, 1)))",
      "gain": "=eff < 150 ? 1 : 0"
     },
     {
      "preset": "Sample",
      "bank": "landing",
      "name": "land_heavy",
      "slot": "landing.land_heavy",
      "variant": "A",
      "intensity": "=min(1, 1.15 * (0.55 + 0.30 * clamp((eff - 150) / 300, 0, 1)))",
      "gain": "=eff >= 150 && eff < 450 ? 1 : 0"
     },
     {
      "preset": "Sample",
      "bank": "landing",
      "name": "land_crash",
      "slot": "landing.land_crash",
      "variant": "A",
      "intensity": 1.0,
      "gain": "=eff >= 450 ? 1 : 0"
     },
     {
      "preset": "Sample",
      "bank": "world48",
      "name": "ride_land",
      "slot": "world48.ride_land",
      "variant": "A",
      "intensity": "=0.35 + 0.35 * u",
      "delayMs": 20
     }
    ],
    "motor": {
     "layers": [
      {
       "preset": "Rumble",
       "steps": [
        [
         0,
         "=round(min(255, 1.2 * (40 + 215 * pow(u, 0.8))))",
         "=round(min(255, 1.2 * (40 + 215 * pow(u, 0.8))))",
         "=round(70 + 300 * u)"
        ]
       ]
      }
     ]
    }
   },
   "note": "Scavenger lands with the rider: the hero's landing v2 tiers (packs/78) x1.15-1.2 + two claw thuds of the mount; hops under 25 cm (steps) silent"
  }
 ]
