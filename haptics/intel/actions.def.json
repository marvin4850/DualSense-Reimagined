      "phases": [ { "name": "draw", "source": "montage:start mc=weapon.draw", "timing": "approx", "params": ["mw"] } ],
      "sound": "COMBAT_Melee_Draw_{w}", "method": "scrape", "approvedRules": ["gen-weapon-draw-*", "weapon-draw-*"],
      "note": "State.ItemDraw is the drawn-weapon STATE (lasts the whole fight), not the moment: the draw montage starts the action" },
