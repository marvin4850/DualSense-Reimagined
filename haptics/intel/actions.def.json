      "phases": [ { "name": "contact", "source": "attack:update res=contact", "timing": "exact", "params": ["dmg", "imp", "last_weapon_fam"] } ],
      "sound": "PHYSICS_Impacts_{impact}", "method": "impact", "approvedRules": ["gen-melee-contact-contact-s1h", "gen-melee-contact-contact-fist"],
      "note": "the game plays its own rumble on melee contact (EVENT_MATRIX): one effect per contact (situation melee.contact)" },
