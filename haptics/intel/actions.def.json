// Logical game actions for the haptic production line (tools/haptic_intel.py). One physical situation = one action:
// several events of the same attack (attack:start, montage, dmgcaused, attack:update) are ONE action with phases, never
// several backlog tasks. Each phase says where its moment comes from and how exact that moment is:
//   exact   - the game reports the moment itself (gameplay event, tag set at that moment, FX definition / notify hook)
//   approx  - start of an animation or a state (the real moment - hit, sound - is later by an unknown offset)
// Fields: events = event signatures that belong to the action ("type:phase" or "type:*", optional where k=v);
//   montages = montage classes (mc from the classifier); primary = the signature that counts one instance;
//   importance: 1 core gameplay feel, 0.7 frequent context, 0.4 ambient, 0 = needs no vibration (rule 5 of AGENTS.md);
//   sound = sound-group template ({w} = weapon sound token, {mat} = material, {gait} = gait) for the matcher;
//   method = default forge audio method; approvedRules = rules the user approved (never replaced by generated ones).
{
  "actions": [
    { "id": "melee.attack", "family": "combat", "title": "Атака ближнего боя (замах по направлению)", "importance": 1.0,
      "events": ["attack:start", "attack:complete"], "montages": ["melee.attack"], "primary": "attack:start",
      "phases": [ { "name": "swing", "source": "attack:start", "timing": "exact", "params": ["dir", "node", "fam"] } ],
      "sound": "COMBAT_Melee_Swing_{w2}", "method": "friction",
      "approvedRules": ["attack-top", "attack-bottom", "attack-left", "attack-right", "attack-kick", "attack-other"],
      "note": "approved on motors (PROGRESS t.61-62): a generated HD swing is only a disabled candidate for A/B" },
