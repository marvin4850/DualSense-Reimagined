    void Observe(UGothicFXDefinition Definition, AActor Actor, const FHitResult &inout Hit)
    {
        if (!Enabled() || Definition == nullptr) return;
        FString KindName = Kind(Definition.GetClass().GetName().ToString());
        if (KindName == "") KindName = Kind(Definition.FModEvent.FMODEventPath.ToString());
        UDsBreadth_State State = Cast<UDsBreadth_State>(Subsystem::GetGameInstanceSubsystem(UDsBreadth_State::StaticClass()));
        if (State == nullptr) return;
        float Now = Gameplay::GetRealTimeSeconds();
        bool Rel = Relevant(Actor, Hit);
        Probe(State, Definition, Actor, Rel, KindName, Now);
        if (KindName == "" || !Rel) return;
        // Same object / same kind can traverse several classes in the replaced hierarchy.
        FString Key = KindName + "_" + (Actor != nullptr ? Actor.GetName().ToString() : "none");
        if (State.LastAt.Contains(Key) && Now - State.LastAt[Key] < 0.025f) return;
        if (State.LastAt.Num() > 512) State.LastAt.Empty();
        State.LastAt.Add(Key, Now);
        UDsLp_Bus Bus = DsLp::Bus();
        FString Mat = "none";
        int Surf = 0;
        UPhysicalMaterial PM = Hit.GetPhysMaterial();
        if (PM != nullptr) { Mat = PM.GetName().ToString(); Surf = int(PM.SurfaceType); }
        FString FXName = Definition.GetClass().GetName().ToString();
        FString Size = FXName.Contains("Large") ? "large" : (FXName.Contains("Small") ? "small" : "unknown");
        if (Bus != nullptr) Bus.Emit("physicalfx", "start", "fx_prepare", "kind=" + KindName + ",mat=" + Mat + ",surf=" + Surf + ",size=" + Size + ",fx=" + FXName);
    }
    FString Clean(FString Text, int MaxLen)
    {
        FString Out = Text.Replace("'", "").Replace(",", "_").Replace(":", "_").Replace("|", "_").Replace("=", "_");
        return Out.Len() > MaxLen ? Out.RightChop(Out.Len() - MaxLen) : Out;
    }
    // Diagnostic (game94: 0 physicalfx). Which FX definitions reach the root at all, and which are the hero's.
    // Hero-relevant: every class, 0.3 s per class. Others: only the first 40 distinct classes (reachability proof).
    void Probe(UDsBreadth_State State, UGothicFXDefinition Definition, AActor Actor, bool Rel, FString KindName, float Now)
    {
        FString Cls = Definition.GetClass().GetName().ToString();
        FString Key = (Rel ? "r_" : "o_") + Cls;
        if (State.ProbeAt.Contains(Key))
        {
            if (!Rel || Now - State.ProbeAt[Key] < 0.3f) return;
        }
        else if (!Rel && State.OtherSeen >= 40) return;
        if (!Rel && !State.ProbeAt.Contains(Key)) State.OtherSeen++;
        State.ProbeAt.Add(Key, Now);
        UDsLp_Bus Bus = DsLp::Bus();
        FString Who = Actor == nullptr ? "none" : Clean(Actor.GetClass().GetName().ToString(), 24);
        if (Bus != nullptr) Bus.Emit("fxprobe", "update", "fx_root", "rel=" + (Rel ? "1" : "0") + ",kind=" + (KindName == "" ? "-" : KindName) + ",cls=" + Clean(Cls, 48) + ",ev=" + Clean(Definition.FModEvent.FMODEventPath.ToString(), 56) + ",who=" + Who);
    }
    void Equipment(FString Phase, AActor Actor, const FHitResult &inout Hit)
    {
        if (Actor != Gameplay::GetPlayerCharacter(0)) return;
        FString Family = EquippedFamily();
        AGothicCharacter WHero = DsLpGame::Hero();
        int WCrouch = WHero != nullptr && WHero.HasGameplayTag(GameplayTag::State_Movement_Crouching) ? 1 : 0;
        // Always on (weapon equipment wave, 16.11.2026): the game's own draw/undraw FX moment with the REAL item type
        // (game95: FX +407 ms after S1H_Un_Draw start = the approved sword draw moment 399 ms). Untrained clubs use the
        // sword montage, so only this event can tell a club from a sword (game92).
        {
            UDsLp_Bus WBus = DsLp::Bus();
            if (WBus != nullptr) WBus.Emit("weaponfx", Phase, "fx_weapon", "family=" + Family + ",crouch=" + WCrouch);
        }
        if (!Enabled()) return;
        // Sword N profiles stay on their approved montage anchors. Fixes only missing/non-blade equipment.
        if (Family == "s1h" || Family == "s2h" || Family == "none" || Family == "unknown") return;
        UDsLp_Bus Bus = DsLp::Bus();
        AGothicCharacter Hero = DsLpGame::Hero();
        int Crouch = Hero != nullptr && Hero.HasGameplayTag(GameplayTag::State_Movement_Crouching) ? 1 : 0;
        if (Bus != nullptr) Bus.Emit("equipmentfx", Phase, "fx_weapon", "family=" + Family + ",crouch=" + Crouch);
    }
