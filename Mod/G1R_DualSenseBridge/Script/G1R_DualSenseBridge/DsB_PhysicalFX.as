UCLASS(meta=(ReplaceParentClass))
class UGothicFXDefinition_DsBreadth : UGothicFXDefinition
{
    UFUNCTION()
    void PrepareFX_Implementation(AActor Instigator, const FHitResult &inout HitResult)
    {
        // Native root: no script Super exists (game93 compile error). The game's own direct native subclasses
        // (footsteps, draw/undraw weapon) never call a base version either, so the native body is treated as an empty hook.
        DsBreadth::Observe(this, Instigator, HitResult);
    }
}
