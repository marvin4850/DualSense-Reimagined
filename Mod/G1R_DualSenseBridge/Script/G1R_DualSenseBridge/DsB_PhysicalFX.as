    bool Enabled() { return System::GetCommandLine().Contains("-DsBreadth"); }
    FString EquippedFamily()
    {
        AGothicCharacter Hero = DsLpGame::Hero();
        if (Hero == nullptr || Hero.GetCarryComponent() == nullptr) return "none";
        UItemDefinition Item = Hero.GetCarryComponent().GetEquippedItemDefinition();
        if (Item == nullptr) return "none";
        FGameplayTag Type = Item.GetItemType();
        if (Type == GameplayTag::Item_Weapon_Mace_OneHand) return "m1h";
        if (Type == GameplayTag::Item_Weapon_Mace_TwoHand) return "m2h";
        if (Type == GameplayTag::Item_Weapon_Axe_OneHand) return "a1h";
        if (Type == GameplayTag::Item_Weapon_Axe_TwoHand) return "a2h";
        if (Type == GameplayTag::Item_Weapon_Sword_OneHand) return "s1h";
        if (Type == GameplayTag::Item_Weapon_Sword_TwoHand) return "s2h";
        if (Type == GameplayTag::Item_Weapon_Staff_TwoHand) return "staff";
        if (Type == GameplayTag::Item_Weapon_Torch_OneHand) return "torch";
        if (Type == GameplayTag::Item_Weapon_Bow) return "bow";
        if (Type == GameplayTag::Item_Weapon_Crossbow) return "crossbow";
        return "unknown";
    }
    bool Relevant(AActor Actor, const FHitResult &inout Hit)
    {
        AGothicCharacter Hero = DsLpGame::Hero();
        if (Hero == nullptr) return false;
        if (Actor == Hero || (Actor != nullptr && Actor.GetOwner() == Hero)) return true;
        if (Hit.GetComponent() != nullptr && Hit.GetComponent().GetOwner() == Hero) return true;
        if (Actor == nullptr) return false;
        UAbilitySystemComponent Asc = Hero.GetAbilitySystemComponent();
        if (Asc == nullptr) return false;
        TArray<FGameplayAbilitySpecHandle> Handles;
        Asc.GetAllAbilities(Handles);
        for (FGameplayAbilitySpecHandle Handle : Handles)
        {
            FGameplayAbilitySpec Spec;
            if (!Asc.FindAbilitySpecFromHandle(Handle, Spec)) continue;
            TArray<UGameplayAbility> Instances = Spec.GetAbilityInstances();
            for (UGameplayAbility Ability : Instances)
            {
                UGameplayAbilityInteractionBase Interaction = Cast<UGameplayAbilityInteractionBase>(Ability);
                if (Interaction != nullptr && !Interaction.m_AbilityEnded && Interaction.m_InteractiveActor.Get() == Actor) return true;
            }
        }
        return false;
    }
