// G1R DualSense Bridge - footstep events for HD haptics (pilot, steps version 2, 15.11.2026).
// v2: only steps while SNEAKING are sent (user: every careful step should matter and depend on the surface; walking / running
// steps stay silent) - also keeps the window-title transport free of 2-3 step records per second.
//
// Source: the game's own footstep FX definition. Every foot contact of a character runs the script function
// UFootStepFXDefinition.PrepareFX_Implementation(Instigator, HitResult) (Sound/FXDefinitions/FXDefinitions_Footsteps.as):
// it is called by the native FootstepNotify of the walk / run / sprint / crouch animations at the moment the foot touches the
// ground, with the physical material under the foot. The official ReplaceParentClass mechanism (as for the player definition in
// DualSenseBridge.as) puts this class between UFootStepFXDefinition and its subclasses (UFootsteps_Walk_Human, ..._Run_, ...),
// so every footstep FX passes through here. Super:: runs the game's own code first: the sound, decal and AI noise are unchanged.
//
// Event (only for the player): step:update mat=<physical material asset name>,gait=walk|run|sprint|crouch,surf=<SurfaceType index>
// DsBridge maps mat to a footstep profile (packs/60-pilot.json, generated by tools/haptic_intel.py). Nothing else is changed.

namespace DsB
{
    const int StepsVersion = 2;
    const bool CrouchOnly = true;
}

UCLASS(meta=(ReplaceParentClass))
class UFootStepFXDefinition_DualSenseBridge : UFootStepFXDefinition
{
    UFUNCTION()
    void PrepareFX_Implementation(AActor Instigator, const FHitResult &inout HitResult)
    {
        Super::PrepareFX_Implementation(Instigator, HitResult);
        if (Instigator == nullptr)
            return;
        AActor PlayerActor = Gameplay::GetPlayerCharacter(0);
        if (PlayerActor == nullptr || Instigator != PlayerActor)
            return;
        AGothicCharacter StepChar = Cast<AGothicCharacter>(Instigator);
        if (StepChar == nullptr)
            return;
        // Landing / take-off contact (game105: 'jumps are late'): ULand_Human / UJump_Human are footstep subclasses fired by the
        // landing / jump animation at the exact foot contact. Reported always (not only crouching), with the surface,
        // so the land effect can be timed by the contact instead of the State.Landing tag.
        FString FxCls = GetClass().GetName().ToString();
        if (FxCls.Contains("Land_Human") || FxCls.Contains("Jump_Human"))
        {
            FString LMat = "none";
            int LSurf = 0;
            UPhysicalMaterial LPM = HitResult.GetPhysMaterial();
            if (LPM != nullptr)
            {
                LMat = LPM.GetName().ToString();
                LSurf = int(LPM.SurfaceType);
            }
            UDsLp_Bus LBus = DsLp::Bus();
            if (LBus != nullptr)
                LBus.Emit(FxCls.Contains("Land_Human") ? "landfx" : "jumpfx", "update", "fx_Footstep", "mat=" + LMat + ",surf=" + LSurf);
            return;
        }
        FString Gait = "walk";
        if (StepChar.HasGameplayTag(GameplayTag::State_Movement_Crouching))
            Gait = "crouch";
        else if (DsB::CrouchOnly)
            return;
        else if (StepChar.HasGameplayTag(GameplayTag::State_Movement_Sprinting))
            Gait = "sprint";
        else if (StepChar.HasGameplayTag(GameplayTag::State_Movement_Running))
            Gait = "run";
        FString Mat = "none";
        int Surf = 0;
        UPhysicalMaterial StepMat = HitResult.GetPhysMaterial();
        if (StepMat != nullptr)
        {
            Mat = StepMat.GetName().ToString();
            Surf = int(StepMat.SurfaceType);
        }
        UDsLp_Bus StepBus = DsLp::Bus();
        if (StepBus != nullptr)
            StepBus.Emit("step", "update", "fx_Footstep", "mat=" + Mat + ",gait=" + Gait + ",surf=" + Surf + ",v=" + DsB::StepsVersion);
    }
}
